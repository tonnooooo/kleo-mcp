/**
 * Kleo Studio — the consumer web app (chat + video generation), Worker "kleo-studio".
 * Deployed on its own, so a Studio release never touches the MCP server:
 *   npx wrangler deploy --config wrangler.studio.jsonc
 *
 * It shares the MCP server's D1 database (users, credits, payments, audit) and R2 bucket. Its own tables
 * (studio_*) are created on first use by src/studio/store.ts; migrations/0017_studio.sql is the same SQL.
 *
 * Secrets (npx wrangler secret put NAME --config wrangler.studio.jsonc):
 *   INTERNAL_SECRET       the SAME value as the MCP server's: it verifies a pasted Kleo key and signs sessions/links
 *   EPHONE_API_KEY        the ePhone AI key (video models and the chat agent)
 *   APIMART_API_KEY       the APIMart key: the backup of most models when ePhone cannot take an order (src/studio/backups.ts)
 *   WAVESPEED_API_KEY     the WaveSpeed key: viral templates, and the backup of GPT Image 2.5 and Character Swap's frame
 *   GOOGLE_CLIENT_ID      optional: Google sign-in (OAuth client "Web application", redirect URI
 *   GOOGLE_CLIENT_SECRET    https://app.kleooai.com/auth/google/callback); the button appears when both are set
 *   MICROSOFT_CLIENT_ID   optional: Microsoft sign-in (Entra app registration, "any organizational directory and personal
 *   MICROSOFT_CLIENT_SECRET Microsoft accounts", Web redirect https://app.kleooai.com/auth/microsoft/callback)
 *   TURNSTILE_SECRET      optional: bot check on sign-up, together with the TURNSTILE_SITEKEY var
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kleo-studio",
  "account_id": "e4a5a1308df5b44c65497b85210c6845",
  "main": "src/studio/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // kleooai.com IS the app (14 Oct 2026, the owner's layout, like higgsfield.ai); the MCP site is served behind it at
  // /mcp and its old addresses (src/studio/site.ts). www. and the first address app. redirect to kleooai.com.
  // DNS records and certificates are made by wrangler (zone kleooai.com is in this account).
  "routes": [
    // { "pattern": "kleooai.com", "custom_domain": true },      ← after the owner deletes the GitHub Pages A records
    // { "pattern": "www.kleooai.com", "custom_domain": true },  ← after the owner deletes the www CNAME
    { "pattern": "app.kleooai.com", "custom_domain": true },
    { "pattern": "admin.kleooai.com", "custom_domain": true } // 23 Oct 2026: the admin console's own host, mTLS-only (src/studio/admin-host.ts)
  ],
  "assets": { "directory": "./studio-web", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "d1_databases": [
    { "binding": "DB", "database_name": "kleo-db", "database_id": "ffaa0767-9df1-4e5c-84f2-552e37851d63", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [ { "binding": "RENDERS", "bucket_name": "kleo-renders" } ],
  // Workers AI: a viral template's photo must show a real person before any charge (src/studio/person-check.ts).
  "ai": { "binding": "AI" },
  // Kleo films are ordered from the MCP Worker (src/studio-film.ts there): same prices, same two-products rule.
  "services": [
    { "binding": "MCP", "service": "kleo-mcp" }
    // 28 Oct 2026, the Kleo mark on clips of accounts that never paid (src/studio/watermark.ts): uncomment AFTER the
    // kleo-watermark Worker exists (watermark/README.md), or every deploy of this Worker fails on the missing service.
    // 29 Oct 2026, the owner: no mark on videos. Leave it commented out: with it, free clips would be marked, because
    // STUDIO_WATERMARK below covers pictures and clips together.
    // , { "binding": "WATERMARK", "service": "kleo-watermark" }
  ],
  // 28 Oct 2026: Cloudflare Images draws the Kleo mark on the pictures of accounts that never paid (src/studio/watermark.ts).
  "images": { "binding": "IMAGES" },
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // The owner's alerts (src/studio/providers.ts): a provider out of money or running low. Email Routing is on for
  // kleooai.com and kleooai@gmail.com is its one verified destination (23 Oct 2026); alerts come from alerts@kleooai.com.
  "send_email": [
    { "name": "OWNER_MAIL", "destination_address": "kleooai@gmail.com" },
    // 27 Oct 2026: the welcome e-mails (src/studio/onboarding.ts) through Cloudflare Email Sending, kleooai.com onboarded
    // as a sending domain; only from hello@kleooai.com.
    { "name": "EMAIL", "allowed_sender_addresses": ["hello@kleooai.com"] }
  ],
  "triggers": { "crons": ["* * * * *"] }, // every minute: refresh clips still with the provider, save finished ones, refund failed ones
  "vars": {
    "PUBLIC_URL": "https://mcp.kleooai.com",
    "CANONICAL_HOST": "", // set to "kleooai.com" once the apex DNS records point to this Worker (owner: delete the GitHub Pages A records first)
    "STRIPE_LINK_5": "https://buy.stripe.com/bJe3cu4XZ1nYh0Ua24dQQ00",
    "STRIPE_LINK_15": "https://buy.stripe.com/8x27sK8abfeOcKEb68dQQ01",
    "STRIPE_LINK_40": "https://buy.stripe.com/dRmeVc0HJ2s25ic7TWdQQ02",
    "STRIPE_PUBLISHABLE_KEY": "pk_live_51UMjBTBkTFrIlSuYDlW0AA1b476OnjNOicuVM132bRiUYPHux28HMXg4yVrDYAIjvrai0y2k93OmlPRsKFrOPd7J00jP4m3sAa", // 21 Oct 2026: public key for Stripe.js (in-app Apple Pay / Google Pay, src/studio/pay.ts); the secret STRIPE_SECRET_KEY is a Worker secret
    "STRIPE_PLAN_LINKS": "{\"lite:month\":\"https://buy.stripe.com/cNibJ09efgiS6mg3DGdQQ03\",\"lite:year\":\"https://buy.stripe.com/bJe5kC0HJ9Uu6mg0rudQQ04\",\"starter:month\":\"https://buy.stripe.com/5kQ3cu4XZeaKbGA3DGdQQ05\",\"starter:year\":\"https://buy.stripe.com/7sYeVc3TV9UueSM4HKdQQ06\",\"pro:month\":\"https://buy.stripe.com/eVq7sKcqr0jUbGA5LOdQQ07\",\"pro:year\":\"https://buy.stripe.com/fZu7sKduv5Ee9ys1vydQQ08\",\"agency:month\":\"https://buy.stripe.com/3cIeVc3TV3w6bGA5LOdQQ09\",\"agency:year\":\"https://buy.stripe.com/bJe6oGgGHeaK3a4fmodQQ0a\",\"agency-590:month\":\"https://buy.stripe.com/3cI4gybmn8Qq7qk4HKdQQ0b\",\"agency-590:year\":\"https://buy.stripe.com/cNi00i3TVgiSeSMb68dQQ0c\",\"agency-750:month\":\"https://buy.stripe.com/6oU6oG3TVgiS8uo2zCdQQ0d\",\"agency-750:year\":\"https://buy.stripe.com/eVq28qeyz7Mmh0Ub68dQQ0e\"}", // 19 Oct 2026: subscription Payment Links of the plans (src/plans.ts linkKey), e.g. {"pro:month":"https://buy.stripe.com/..."}; a plan without a link says it opens soon
    "FREE_CREDITS": "5",
    "MAX_NEW_USERS_PER_DAY": "150",
    "MAX_NEW_USERS_PER_IP_DAY": "5",
    "STUDIO_FREE_MODELS": "seedance-2.0-fast", // the owner's rule (15 Sep 2026): gifted credits never buy the expensive models
    "STUDIO_FREE_IMAGE_MODELS": "nano-banana-2,seedream-5,flux-2-pro", // 20 Oct 2026, the owner: Nano Banana 2.1 and FLUX 3 unlock with the first purchase too (2.1 made four 4K pictures for one credit, FLUX 3 costs $0.32 a 4K picture); Nano Banana Pro and GPT Image 2.5 were never open
    "NOTIFY_FROM": "Kleo <noreply@kleooai.com>", // sender of the password-reset e-mail; nothing is sent until the RESEND_API_KEY secret is set
    "STUDIO_MARGIN": "1.6",
    "STUDIO_VIDEO_FACTOR": "5/3", // 25 Oct 2026, the owner: "da 6 crediti per 480p fai 10": every video clip and template run costs its credits x 5/3, rounded up (src/studio/models.ts videoFactor)
    "STUDIO_DAILY_BUDGET_USD": "30",
    "TURNSTILE_SITEKEY": "0x4AAAAAAFWD13GJ3SI11_Ww", // public key of the Turnstile widget "Kleo sign-up" (14 Oct 2026); TURNSTILE_SECRET is a secret
    "STUDIO_FREE_DAILY_BUDGET_USD": "8", // accounts that never paid share this part of the day (14 Oct 2026)
    "MAX_GIFTS_PER_ADDRESS": "2", // 18 Oct 2026, the owner: "max due volte, se fanno una terza gli blocchi l'IP" (src/abuse.ts); one browser still gets one gift (the __Host-kleo_gift cookie)
    "MAX_ACCOUNTS_PER_ADDRESS": "2", // the third account from one address inside GIFT_WINDOW_DAYS is refused and the address blocked for ADDRESS_BLOCK_DAYS; paying accounts are never touched
    "STUDIO_ADMINS": "u_6avhjrtnzrsa", // 15 Oct 2026: the owner's own account (leo…@gmail.com): every model, no limits (src/studio/generate.ts isAdmin); also in wrangler.jsonc, where it keeps the Kleo mark off the admin's animatics (src/mark.ts)
    "STUDIO_WATERMARK": "", // 29 Oct 2026: "off" stops the Kleo mark on free pictures and clips; animatics and films follow wrangler.jsonc, which is "off" since 29 Oct 2026 (the owner: no mark on videos)
    "STUDIO_PAUSED_IMAGE_MODELS": "", // 18 Oct 2026, the owner: Nano Banana Pro and 2 back online (paused 15 Oct for "invalid channel id"); a model listed here takes no orders
    "STUDIO_MAX_RUNNING": "3",
    "STUDIO_MAIL_DAILY_CAP": "300", // 27 Oct 2026: welcome e-mails one UTC day may send (src/studio/onboarding.ts); the switch is in the admin console's Emails page
    "STUDIO_MAIL_PER_TICK": "12",
    "STUDIO_AGENT_MODEL": "claude-haiku-5-5",
    "STUDIO_AGENT_PER_DAY": "200",
    "ADMIN_HOST": "admin.kleooai.com", // 23 Oct 2026: the admin console lives only here (src/studio/admin-host.ts); /admin on every other host is the site's 404
    "ADMIN_CERT_SHA256": "47f40b62f8a92ed84e56a939ad3f929cd6b3b501fdb2b5ab5cd204226e929f18" // SHA-256 of the owner's client certificate "CN=Kleo admin - owner PC, O=Kleo" (Cloudflare Managed CA, ECDSA P-256, valid to 22 Oct 2028); not a secret. Several: comma separated. EMPTY = the admin host opens for nobody (fail closed)
  }
}
