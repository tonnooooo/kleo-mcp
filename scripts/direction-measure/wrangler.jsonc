{
  // Il banco di misura della fase 0. Non e' Kleo: nessun D1, nessun R2, nessun cron, nessuna rotta pubblica.
  // Si avvia SOLO con `npx wrangler dev --remote -c scripts/direction-measure/wrangler.jsonc`, cosi' il modello
  // gira sul bordo di Cloudflare e non sul computer di casa. Non va mai deployato.
  //
  // E SI AVVIA DA UN WORKTREE STACCATO, MAI DALLA CARTELLA CONDIVISA. Come il deploy, `wrangler dev` impacchetta
  // l'albero cosi' com'e': il 12 settembre il banco e' partito dalla cartella mentre un'altra sessione aveva li'
  // dentro un prompt diverso da quello committato, e il numero misurato era di un testo che non stava in nessun
  // commit. Ricetta: git worktree add --detach /tmp/bench origin/main && ln -s $PWD/node_modules /tmp/bench/ &&
  // (cd /tmp/bench && npx wrangler dev --remote -c scripts/direction-measure/wrangler.jsonc --port 8798).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kleo-direction-bench",
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "vars": { "AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct" }
}
