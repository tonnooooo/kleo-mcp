/**
 * kleo-watermark — the Kleo mark on free clips (README.md). Deployed on its own, from GitHub only:
 *   .github/workflows/watermark.yml, "Run workflow" with deploy = true (needs the CLOUDFLARE_API_TOKEN secret)
 * wrangler builds ./Dockerfile with the runner's Docker and pushes it to Cloudflare's registry.
 * kleo-studio reaches it through its WATERMARK service binding (wrangler.studio.jsonc).
 */
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kleo-watermark",
  "account_id": "e4a5a1308df5b44c65497b85210c6845",
  "main": "worker.js",
  "compatibility_date": "2026-07-02",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "containers": [
    { "class_name": "Marker", "image": "./Dockerfile", "instance_type": "basic", "max_instances": 3 }
  ],
  "durable_objects": { "bindings": [ { "name": "MARKER", "class_name": "Marker" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Marker"] } ],
  "vars": { "MAX_BOXES": "3" }
}
