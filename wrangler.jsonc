/**
 * Kleo MCP server — configurazione del Cloudflare Worker (wrangler).
 * I valori qui sotto sono quelli di PRODUZIONE: dopo ogni modifica serve `npm run deploy`
 * (attenzione: la produzione usa GPU vere, ogni video creato costa denaro).
 *
 * I segreti NON stanno in questo file. Si caricano una volta con `npx wrangler secret put NOME`:
 *   INTERNAL_SECRET  firma i link di download, l'identita' dell'account (cookie e "chiave Kleo") e protegge le rotte /internal
 *                    ATTENZIONE: se lo cambi, tutti gli account anonimi diventano irraggiungibili (vedi DEPLOY.md)
 *   VAST_API_KEY     chiave Vast.ai per noleggiare le GPU
 *   KIE_API_KEY      chiave kie.ai (kie.ai/api-key) per le clip dei film (src/footage.ts); resta sul server, la scheda non la vede mai
 *   POOL_SECRET      (facoltativo) chiave con cui i runner GitHub Actions (render-pool.yml) prendono i video in attesa
 *   RESEND_API_KEY, NOTIFY_FROM  (facoltativi, oggi non impostati) email con i link a fine render
 *   TURNSTILE_SECRET (facoltativo, oggi NON impostato) controllo anti-robot della pagina di accesso: finche' manca il
 *                    controllo e' saltato del tutto. Da impostare solo insieme al widget sulla pagina (fase 2), altrimenti
 *                    nessuno riesce piu' a entrare
 * Una copia dei valori reali è in .secrets.local (fuori da git).
 *
 * Le risorse (KV, D1, R2) esistono già nell'account "Plural Juice"; scripts/finish-install.sh le ricrea se mancano.
 * Variabili facoltative NON impostate qui (valgono i predefiniti nel codice, src/env.ts):
 *   START_TIMEOUT_MIN (15: minuti di silenzio di una GPU appena noleggiata prima di distruggerla e rimettere il video in coda),
 *   VAST_MIN_CPU (16 core) e VAST_MIN_RAM_GB (32): requisiti minimi della macchina, perché il render è lavoro di CPU,
 *   VAST_BOOTSTRAP_URL (script del worker da scaricare al boot: non serve, l'immagine lo contiene già),
 *   KLEO_WIDTH_PORTRAIT (2160) e KLEO_WIDTH_LANDSCAPE (3840): larghezza in pixel dei video 9:16 e 16:9. Nessuna
 *     delle due e' impostata qui: le decide l'immagine del worker, e qui si scrivono solo per forzarle,
 *   BRAND ("Kleo": il marchio mostrato nei video), MOCK_TOTAL_SECONDS (durata del render finto in modalità mock),
 *   TURNSTILE_SITEKEY (fase 2: chiave pubblica del widget anti-robot, quando lo aggiungeremo alla pagina di accesso),
 *   IMAGE_FIXTURE ("1" solo in locale: immagini segnaposto al posto di Workers AI, vedi .dev.vars).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kleo-mcp", // nome del Worker: compare nell'indirizzo kleo-mcp.<account>.workers.dev
  "account_id": "e4a5a1308df5b44c65497b85210c6845", // account Cloudflare "Plural Juice"
  "main": "src/index.ts", // punto d'ingresso del server
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true }, // log e metriche visibili nella dashboard Cloudflare
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "5e3ad54946764fa781fcd17c0a735bff" } // token di accesso dei client (Claude, ChatGPT, Cursor...)
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "kleo-db", "database_id": "ffaa0767-9df1-4e5c-84f2-552e37851d63", "migrations_dir": "migrations" } // utenti, crediti, codici bonus, video, log
  ],
  "r2_buckets": [ { "binding": "RENDERS", "bucket_name": "kleo-renders" } ], // i file dei video (MP4, .srt, thumbnail), cancellati dopo RESULT_TTL_DAYS
  "ai": { "binding": "AI" }, // Workers AI: scrive lo storyboard dal prompt (gratis entro la quota giornaliera; modello in AI_MODEL) e genera le immagini delle scene (IMAGE_MODEL_*)
  // Limite di richieste sulla pagina di accesso: 3 tentativi al minuto per indirizzo (l'indirizzo non viene mai
  // salvato, se ne usa solo un'impronta). Non serve alcun account esterno: è configurazione e basta.
  "ratelimits": [
    { "name": "SIGNUP_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "triggers": { "crons": ["* * * * *"] }, // ogni minuto: storyboard dei video in coda, noleggio GPU, controllo dei render, pulizia dei file scaduti
  "vars": {
    "PUBLIC_URL": "https://mcp.kleooai.com", // indirizzo pubblico del server; l'indirizzo MCP da dare ai client è PUBLIC_URL + /mcp
    "STRIPE_LINK_5": "https://buy.stripe.com/5kQ5kDfTB19681jgZf9ws03", // 5 EUR · 10 crediti · Payment Link live
    "STRIPE_LINK_15": "https://buy.stripe.com/5kQ9AT6j1bNKa9r7oF9ws04", // 15 EUR · 35 crediti · Payment Link live
    "STRIPE_LINK_40": "https://buy.stripe.com/7sY14nbDlaJG6XfdN39ws05", // 40 EUR · 100 crediti · Payment Link live
    "RENDER_BACKEND": "vast", // chi fa i render: "vast" = GPU vere a pagamento (produzione) · "mock" = finto, gratis, 1 minuto (test) · "pool" = solo i runner GitHub · "manual" = un container avviato a mano
    "POOL_AFTER_MIN": "3", // in modalità vast: un video fermo in coda da tanti minuti può essere preso dal runner gratuito di GitHub Actions (render-pool.yml)
    "VAST_RETRY_MIN": "5", // se Vast.ai risponde "nessuna offerta" o "credito finito", non lo si interpella per tanti minuti (intanto lavorano i runner). Era 30: sabato 12 settembre alle 23:23 UTC una ricerca a vuoto ha spento il noleggio per mezz'ora, e nel frattempo nel mercato una macchina buona era comparsa e sparita due volte — le offerte cambiano di minuto in minuto, e una ricerca costa una chiamata
    "AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct", // modello Workers AI che scrive lo storyboard
    "IMAGE_MODEL_CARTOON": "@cf/black-forest-labs/flux-1-schnell", // Workers AI: immagini dello stile "cartoon" (≈58 neuroni ≈ $0.0006 a immagine, 1024², max 10 per video)
    "IMAGE_MODEL_REALISTIC": "@cf/leonardo/phoenix-1.0", // Workers AI: immagini dello stile "realistic" (≈2.300 neuroni ≈ $0.025 a immagine a 768x1344; alternativa gratuita in beta: @cf/bytedance/stable-diffusion-xl-lightning)
    "MAX_CONCURRENT_GPUS": "2", // massimo GPU accese in totale. Il caso peggiore teorico e' 2 x VAST_MAX_DPH = 1,20 $/h, ma non e' quello che si spende: la ricerca prende sempre la piu' economica (0,169 $/h misurati), e sopra a tutto c'e' DAILY_GPU_BUDGET_USD, che e' il muro vero
    "MAX_CONCURRENT_VIDEO_GPUS": "1", // di quelle GPU, quante possono fare un video GENERATO insieme: una. Sono le schede piu' care e sono quelle il cui conto triplica quando una clip torna ferma e va rifatta: due in parallelo sono l'unico modo in cui il credito puo' sparire senza che nessuno se ne accorga
    "MAX_JOBS_PER_USER": "1", // massimo video in corso per ogni utente: con solo 2 GPU un account non deve occuparle tutte e due
    "MAX_JOBS_PER_DAY": "8", // massimo video AVVIATI in un giorno (UTC) da uno stesso account: il limite qui sopra conta solo quelli in corso. 2→4→8 il 13 set: quattro bastavano a chiudere fuori il proprietario che prova il prodotto
    "START_TIMEOUT_MIN": "25",
    "RENDER_SILENCE_MIN": "45", // minuti di silenzio tollerati a un render in corso (predefinito 20). 13 set: la stesura della traccia 4K da sette clip 2K di kie.ai ha superato i 20 minuti muta sulla macchina di finitura e il film e' stato ucciso al 62% due volte. Il worker ora riferisce ogni parte finita: quando l'immagine nuova e' in produzione si puo' tornare a 20
    "LOADING_RETRY_MIN": "22", // dopo tanti minuti di solo download il lavoro passa a un'altra macchina
    "LOADING_TIMEOUT_MIN": "40", // oltre questo un noleggio che non parte viene chiuso
    "JOB_TIMEOUT_MIN": "60", // minuti di vita di un render prima di essere considerato fallito (GPU distrutta, crediti restituiti). È un MINIMO, non un massimo: per i video lunghi il limite si alza da solo (stima del video + LOADING_TIMEOUT_MIN, src/templates.ts), altrimenti un video da 8 minuti — che il server stesso annuncia in 80 — verrebbe ucciso a 60 e non potrebbe mai finire. Per uno Short (23 minuti misurati) vale questo 60
    "QUEUE_MAX_WAIT_MIN": "180", // un video che dopo 3 ore non ha ancora trovato una GPU fallisce e i crediti tornano indietro (senza questo resterebbe in coda per sempre)
    "DAILY_GPU_BUDGET_USD": "20.00", // 13 set: con LTX-2.5 su schede da 80 GB (1,5-2,6 $/h) la stima "prezzo x timeout" di UN film supera 3 $ e la pausa scattava subito; 20 $ = una decina di film al giorno. Il credito Vast resta il muro reale. // il vero muro: oltre questa spesa stimata in un giorno (UTC) Kleo non noleggia più GPU per un'ora e i video restano in coda. È una STIMA (conta i noleggi finiti, falliti e annullati, più quelli accesi al prezzo massimo): la cifra vera resta il saldo su console.vast.ai. Era 1,00: il 13 settembre, con le macchine verificate a 0,80-0,96 $/h, un dollaro al giorno era un video al giorno, e il proprietario ha chiesto tre
    "VAST_MIN_BALANCE_TO_SELL": "1.00", // sotto questo saldo Vast i bottoni dei pacchetti SPARISCONO da soli e la pagina dice "in pausa un momento": il 12 settembre la vendita era aperta con 0,00 $ di GPU, cioe' crediti in vendita per un servizio che non poteva consegnare. Il webhook invece accredita comunque chi ha gia' pagato. Torna tutto da solo entro 15 minuti dalla ricarica
    "FREE_FILMS": "1", // FILM gratis per ogni nuovo account anonimo; i crediti li calcola il server dal prezzo del film (src/templates.ts freeCreditsFor: oggi 7). Si conta in film e non in crediti apposta: il vecchio FREE_CREDITS=2 e' rimasto fermo quando il film e' passato a 7 e per un giorno ogni nuovo account e' stato invitato a "start free" senza poter fare niente (un amico, 13 set 12:28Z). Costo vivo di un film gratis: circa 1,3-2 $ (clip kie.ai + GPU); a difendere il conto restano i 25 account al giorno, i 5 per indirizzo, DAILY_FOOTAGE_BUDGET_USD e DAILY_GPU_BUDGET_USD. 0 = nessuna prova gratuita
    "MAX_NEW_USERS_PER_DAY": "25", // nuovi account creati in un giorno (UTC); oltre, la pagina dice di tornare domani senza accusare nessuno
    "MAX_NEW_USERS_PER_IP_DAY": "5", // nuovi account al giorno da uno stesso indirizzo (di cui si salva solo un'impronta): senza questo, 25 richieste da un solo visitatore chiudono la prova gratuita a tutti fino a mezzanotte
    "RESULT_TTL_DAYS": "7", // giorni di validità dei link e dei file
    "VAST_MAX_DPH": "1.00", // prezzo massimo per una singola offerta. NON e' il tetto di spesa: quello e' DAILY_GPU_BUDGET_USD. La ricerca ordina per prezzo crescente e prende le prime, quindi alzare questo numero non fa noleggiare macchine piu' care — decide solo QUANTE ne restano quando le economiche sono occupate. Misurato l'11 settembre sulle offerte vere: a 0,40 ne restavano 8, a 0,60 ne restano 17, e la piu' economica e' la stessa in tutti e due i casi (0,169 $/h). A 0,40 capitava che non ne restasse nessuna e i video aspettavano mezz'ora prima ancora di provarci. Rimisurato sabato 12 settembre alle 23:19 UTC, cioe' nel picco del fine settimana americano: di macchine verificate con 16 GB e Ampere ce n'erano SETTE in tutto il mercato sotto 1,50 $/h, a 0,60 ne passava ZERO e un video e' rimasto tre ore a "waiting for a free GPU"; a 1,00 ne passa una (A100 40 GB, 0,68 $/h). Il muro dei soldi resta il budget giornaliero
    "VAST_MIN_INET": "1200", // Mbit/s in discesa richiesti alla macchina (il predefinito è 800): dei 23 minuti misurati, 13 erano solo lo scaricamento dell'immagine, cioè più della metà del conto
    "IMAGE_SERVER_MAX": "0", // immagini disegnate dal server con Workers AI: nessuna. Le disegna tutte la GPU noleggiata (circa 0,004 $ per 24), così la quota gratuita giornaliera di Workers AI resta intera per gli storyboard, che è ciò che limita davvero quanti video Kleo sa progettare in un giorno
    "VAST_DISK_GB": "80", // disco richiesto alla macchina (l'immagine del worker pesa circa 11 GB); un job filmato con LTX ne chiede 150 da solo (src/templates.ts videoDiskGb)
    "KLEO_FOOTAGE_BACKEND": "kie", // da dove arrivano le CLIP di un film (13 set, src/footage.ts): "kie" = l'API di kie.ai (Kling, Veo, Wan, Seedance) chiamata dal server; la scheda noleggiata diventa quella economica da 16 GB e carica solo i fotogrammi di riferimento. "local" = il modello qui sotto sulla scheda da 80 GB. Vale solo se il segreto KIE_API_KEY e' caricato (`npx wrangler secret put KIE_API_KEY`), altrimenti resta "local" da solo. Si cambia anche senza deploy: POST /internal/admin/footage {"backend":"kie"|"local","model":"..."}
    "KLEO_FOOTAGE_MODEL": "minimax-h3", // modello kie.ai (nomi in src/footage.ts KIE_MODELS): minimax-h3 (2K, 0,065 $/s, il default dal 13 set: 3o in classifica, sopra Kling), minimax-h3-768p, gemini-omni-flash (1o in classifica, a clip), gemini-omni-flash-4k, kling-3.0 (pro 1080p, la riserva collaudata), kling-3.0-std, kling-3.0-4k, kling-v3-turbo, veo-3.1, wan-2.7, seedance-2.0 (0,51 $/s: solo confronti)
    "KIE_MAX_VIDEO_S": "20", // fase di prova: un film piu' lungo di tanti secondi NON va su kie.ai e prende la strada locale. 0 = nessun tetto
    "DAILY_FOOTAGE_BUDGET_USD": "5.00", // tetto giornaliero (UTC) della spesa STIMATA su kie.ai, contata alla creazione di ogni task dal listino in src/footage.ts; oltre, la richiesta di clip viene rifiutata e il film fallisce con la frase esatta. Prezzi VERI letti dal listino kie.ai il 13 set. Un film da 20 s costa circa 1,3 $ su MiniMax H3, 1,8 $ su Kling 3.0 pro
    "KLEO_VIDEO_MODEL": "Lightricks/LTX-2.5-Diffusers", // il generatore delle riprese (13 set: LTX-2.5, 22B, pesi gated -> secret HF_TOKEN; scheda da 80 GB, tetto 2,60 $/h). Wan-AI/Wan2.2-TI2V-5B-Diffusers per tornare al modello piccolo
    "VAST_IMAGE": "ghcr.io/tonnooooo/kleo-worker:keou" // immagine Docker del worker (motore Keou + modelli), costruita da GitHub Actions (worker-image.yml); deve restare pubblica
  },
  "dev": { "port": 8787 } // porta di `npm run dev` in locale (i test usano le porte 8796–8799)
}
