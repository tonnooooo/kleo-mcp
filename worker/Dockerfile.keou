# Kleo worker image with the Keou motion-design engine baked in (CPU or GPU).
#   cd /home/madiva/kleo/kleo-mcp && podman build -f worker/Dockerfile.keou -t kleo-worker:keou .
# Layers are ordered so that source edits never re-download Node, Chromium, pip deps or models
# (the SD picture models are keyed on prewarm_models.py + contract.py only, never on kleo_pictures.py).
FROM docker.io/pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/kleo/hf HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/kleo/ms-playwright \
    KEOU_ROOT=/opt/kleo/keou PATH=/usr/local/bin:$PATH

# --- system packages (mirrors keou/bootstrap.sh) ---
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends fonts-noto-color-emoji \
      ffmpeg espeak-ng curl xz-utils ca-certificates rsync util-linux fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# --- Node 22 from the official tarball, checksum verified like bootstrap.sh ---
ARG NODE_VERSION=22.23.2
RUN cd /tmp && curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz -o node.tar.xz \
    && curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt -o node-sha.txt \
    && grep " node-v${NODE_VERSION}-linux-x64.tar.xz\$" node-sha.txt | sed 's/  .*/  node.tar.xz/' | sha256sum -c - \
    && tar -xJf node.tar.xz -C /usr/local --strip-components=1 && rm -f node.tar.xz node-sha.txt \
    && node --version && npm --version

# --- JS deps + Chromium (only package*.json here, so source edits keep this layer) ---
WORKDIR /opt/kleo/keou
COPY worker/keou/package.json worker/keou/package-lock.json ./
RUN npm ci --no-audit --no-fund && npx playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* /root/.npm

# --- Python deps + the spaCy model misaki would otherwise download on first run ---
COPY worker/keou/requirements.txt ./
RUN pip install -r requirements.txt \
    && pip install https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl

# --- Python deps for local picture generation (diffusers on the base image's torch; see worker/kleo_pictures.py) ---
COPY worker/requirements-pictures.txt /opt/kleo/requirements-pictures.txt
RUN pip install -r /opt/kleo/requirements-pictures.txt && pip check \
    && python3 -c "import diffusers, transformers, accelerate, safetensors; print('diffusers', diffusers.__version__, 'transformers', transformers.__version__)" \
    && python3 -c "from diffusers import LTX2Pipeline, LTX2LatentUpsamplePipeline, WanImageToVideoPipeline; import cv2, ftfy; print('video pipelines: ltx2 + wan, cv2', cv2.__version__)"

# --- Models: Kokoro-82M + every contract voice, faster-whisper small/int8, and the two SD1.5 picture checkpoints
#     (dreamshaper-8 for cartoon, Realistic_Vision_V5.1 for realistic: fp16 safetensors + configs, ~2 GB each), all in
#     the HF cache inside the image. Only the CARTOON checkpoint is baked in: every gigabyte in the image is
#     downloaded again by every rented instance before it can start, and the realistic checkpoint comes from
#     Hugging Face on the instance itself in about half a minute when a realistic job needs it.
#     PREWARM_PICTURES=all bakes both, =0 bakes none. ---
ARG PREWARM_PICTURES=1
COPY worker/keou/contract.py /opt/kleo/prewarm/contract.py
COPY worker/prewarm_models.py /opt/kleo/prewarm/prewarm_models.py
RUN HF_HUB_OFFLINE=0 PREWARM_PICTURES=${PREWARM_PICTURES} python3 /opt/kleo/prewarm/prewarm_models.py /opt/kleo/prewarm/contract.py \
    && rm -rf /root/.cache/pip && du -sh /opt/kleo/hf

# --- The neural finish of the footage track (worker/kleo_sr.py): Real-ESRGAN compact weights (BSD-3) and RIFE 4.25
#     (MIT), ~105 MB. Here, after the prewarm layer, so the base and the 2.7 GB models keep their digests.
#     Every file is pinned by size and sha256 — the same table as kleo_sr.WEIGHTS / RIFE_ZIP (test_kleo_video holds the
#     two together). The Real-ESRGAN files come from the author's GitHub release, with a Hugging Face mirror pinned to a
#     commit as the fallback (its published LFS sha256 is the pinned value, and matches other independent mirrors of
#     the same size). RIFE 4.25 is published by its author on Google Drive only: two Hugging Face copies of the same
#     zip (same sha256) stand in for it, and only train_log/flownet.pkl is kept (the network is vendored in kleo_sr).
#     No pip realesrgan/basicsr: basicsr imports torchvision.transforms.functional_tensor, gone in torchvision 0.23.
#     --no-deps + pip check: spandrel runs on the base image's torch and torchvision, it never pulls its own. ---
RUN pip install --no-deps spandrel==0.4.2 einops==0.8.1 && pip check && mkdir -p /opt/kleo/sr/rife425 && cd /opt/kleo/sr \
    && get() { for u in "$2" "$3"; do curl -fsSL --retry 3 --max-time 300 -o "$1" "$u" \
                 && [ "$(stat -c %s "$1")" = "$4" ] && echo "$5  $1" | sha256sum -c - && return 0; done; return 1; } \
    && get realesr-general-x4v3.pth https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesr-general-x4v3.pth \
           https://huggingface.co/leonelhs/realesrgan/resolve/6907f85a9095e201ec4b3c7e91bbb66cdec0f04d/realesr-general-x4v3.pth \
           4885111 8dc7edb9ac80ccdc30c3a5dca6616509367f05fbc184ad95b731f05bece96292 \
    && get realesr-general-wdn-x4v3.pth https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesr-general-wdn-x4v3.pth \
           https://huggingface.co/leonelhs/realesrgan/resolve/6907f85a9095e201ec4b3c7e91bbb66cdec0f04d/realesr-general-wdn-x4v3.pth \
           4885111 1641f8c4464b9f097c9fdda5589273713f67cf59f3d909e0bd688f0cee269dca \
    && get realesr-animevideov3.pth https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesr-animevideov3.pth \
           https://huggingface.co/leonelhs/realesrgan/resolve/6907f85a9095e201ec4b3c7e91bbb66cdec0f04d/realesr-animevideov3.pth \
           2504012 b8a8376811077954d82ca3fcf476f1ac3da3e8a68a4f4d71363008000a18b75d \
    && get RealESRGAN_x2plus.pth https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.1/RealESRGAN_x2plus.pth \
           https://huggingface.co/leonelhs/realesrgan/resolve/6907f85a9095e201ec4b3c7e91bbb66cdec0f04d/RealESRGAN_x2plus.pth \
           67061725 49fafd45f8fd7aa8d31ab2a22d14d91b536c34494a5cfe31eb5d89c2fa266abb \
    && get rife425.zip https://huggingface.co/r3gm/RIFE/resolve/7ebada9b4387e6a599766e40816876ec500c93d0/RIFEv4.25_0919.zip \
           https://huggingface.co/myfuturecsl/RIFE/resolve/3f5952a40952693dfad03d0606f64a815e7ad41d/RIFEv4.25_0919.zip \
           22919050 e63d481b7ae5d4a4e6ad7ac5b410ff78f3bf7be3b51b2e38ca8152747abde5b4 \
    && python3 -c "import zipfile; open('rife425/flownet.pkl','wb').write(zipfile.ZipFile('rife425.zip').read('train_log/flownet.pkl'))" \
    && rm -f rife425.zip && sha256sum *.pth rife425/flownet.pkl > SHA256SUMS && cat SHA256SUMS && du -sh /opt/kleo/sr

# --- Engine source + worker (last: cheapest layers to rebuild) ---
COPY worker/keou /opt/kleo/keou

# --- Kleo picture-style fonts (OFL, google/fonts): Baloo 2 for the cartoon look, Oswald for the
#     realistic one. Pinned to one commit, never "main": every video we have ever shipped in the
#     picture style was cut with these two outlines, and an unpinned fetch would re-cut the
#     typography under us the day upstream ships a new build of either family.
#     b6f0fe17 is the commit that last touched Oswald[wght].ttf (2023-07-20); Baloo2[wght].ttf has
#     not moved since 2021-11-25, so that one tree pins both files.
#     Verified by exact byte length and git blob id (the sha1 of "blob <len>\0" + content, which is
#     the very id github.com/google/fonts publishes for the blob, so the expected values below can
#     be re-checked against the API without downloading anything). A size floor alone would let a
#     silently re-hinted font through.
#     The layer stays here, after the engine COPY: engine/assets/ lives inside worker/keou, so the
#     fonts must land after that COPY or it would wipe them. film.html falls back to Manrope when a
#     file is missing, so a failure here is a build failure, never a broken render. ---
ARG GOOGLE_FONTS_REF=b6f0fe1740573b70ee367fbaba04b7586be85af3
RUN curl -fsSL --retry 3 --max-time 180 "https://raw.githubusercontent.com/google/fonts/${GOOGLE_FONTS_REF}/ofl/baloo2/Baloo2%5Bwght%5D.ttf" -o /opt/kleo/keou/engine/assets/cartoon.ttf \
    && curl -fsSL --retry 3 --max-time 180 "https://raw.githubusercontent.com/google/fonts/${GOOGLE_FONTS_REF}/ofl/oswald/Oswald%5Bwght%5D.ttf" -o /opt/kleo/keou/engine/assets/real.ttf \
    && python3 -c 'import hashlib,sys;A="/opt/kleo/keou/engine/assets/";W=[("cartoon.ttf",683200,"bc1b9f1191c0d6d23cb2ce0af66aba82ddbf8d6c"),("real.ttf",172088,"d1a3b9cb1325bf20b3a06ef9849d21c411212a3b")];D={n:open(A+n,"rb").read() for n,_,_ in W};B={n:hashlib.sha1(("blob %d"%len(d)).encode()+bytes(1)+d).hexdigest() for n,d in D.items()};bad=["%s: got %d bytes blob %s, want %d bytes blob %s"%(n,len(D[n]),B[n],s,h) for n,s,h in W if len(D[n])!=s or B[n]!=h];bad and sys.exit("Font verification failed: "+"; ".join(bad));print("FONTS_OK",[(n,len(d)) for n,d in D.items()])'

COPY worker/kleo_pictures.py /opt/kleo/kleo_pictures.py
# The generated-motion module. It was never copied: in production every storyboard that asked to be filmed fell
# back to the stills with "kleo_video is not in this image" in a log nobody read (found 13 September).
COPY worker/kleo_video.py /opt/kleo/kleo_video.py
# The neural finish kleo_video calls on a finish box with a usable GPU. The check loads every network on the CPU and
# runs each once: a weight that does not fit its network fails the build here, never a film.
COPY worker/kleo_sr.py /opt/kleo/kleo_sr.py
RUN cd /opt/kleo && python3 -c "import kleo_sr; ok, why = kleo_sr.weights_ok(); assert ok, why; print(kleo_sr.selfcheck())"
COPY worker/kleo_worker.py /opt/kleo/kleo_worker.py
RUN node --version > runtime-node.txt && ffmpeg -version | head -1 > runtime-ffmpeg.txt \
    && pip freeze > runtime-python.txt && python3 -c "import contract; print('contract', contract.VERSION, sorted(contract.VOICES))"

WORKDIR /opt/kleo
CMD ["python3", "/opt/kleo/kleo_worker.py"]
